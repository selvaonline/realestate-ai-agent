{
  "comment": "Level-1 evals: golden test cases run directly against POST /api/tools/execute (no LLM). 'requires' lists external dependencies; cases are skipped unless those are available. 'expect' supports: ok (bool), result_keys (keys that must exist in result), contains (substring of JSON-serialized result).",
  "cases": [
    {
      "name": "dcf_basic_math",
      "tool": "run_dcf",
      "args": { "purchasePrice": 4200000, "noi": 290000, "holdYears": 10 },
      "requires": [],
      "expect": { "ok": true, "contains": "irr" }
    },
    {
      "name": "dcf_defaults_applied",
      "tool": "run_dcf",
      "args": { "purchasePrice": 1000000, "noi": 65000 },
      "requires": [],
      "expect": { "ok": true }
    },
    {
      "name": "score_deals_ranks_rows",
      "tool": "score_deals",
      "args": {
        "rows": [
          { "title": "Walgreens NNN - Tampa FL - 6.1% CAP - $4.2M", "url": "https://www.crexi.com/properties/example-1", "snippet": "Single tenant net lease Walgreens, 6.1% cap rate, $4,200,000, NOI $256,200, 12 years remaining" },
          { "title": "Vacant retail strip - rural GA", "url": "https://www.loopnet.com/listing/example-2", "snippet": "Value-add opportunity, 40% occupied strip center" }
        ],
        "query": "NNN pharmacy Florida"
      },
      "requires": [],
      "expect": { "ok": true, "contains": "peScore" }
    },
    {
      "name": "tenant_credit_walgreens",
      "tool": "tenant_credit_analysis",
      "args": { "tenantName": "Walgreens", "leaseTermYears": 12, "annualRent": 256200, "propertyType": "NNN retail" },
      "requires": [],
      "expect": { "ok": true }
    },
    {
      "name": "risk_assessment_tampa",
      "tool": "assess_risk",
      "args": { "query": "NNN retail Tampa Florida", "forceMetro": "Tampa" },
      "requires": ["fred"],
      "expect": { "ok": true }
    },
    {
      "name": "macro_data_dallas",
      "tool": "get_macro_data",
      "args": { "metro": "Dallas" },
      "requires": ["fred"],
      "expect": { "ok": true }
    },
    {
      "name": "search_finds_listings",
      "tool": "search_properties",
      "args": { "query": "NNN Walgreens Florida", "maxResults": 5 },
      "requires": ["web"],
      "expect": { "ok": true, "result_keys": ["scored", "rawCount"] }
    }
  ]
}
