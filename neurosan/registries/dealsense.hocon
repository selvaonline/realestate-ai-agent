                        "maxResults": {
                            "type": "float",
                            "description": "Max results to return (default 20, max 30)"
                        }
                    },
                    "required": [
                        "query"
                    ]
                }
            },
            "class": "orchestrator_api.OrchestratorTool",
            "args": {
                "tool_name": "search_properties"
            }
        },
        {
            "name": "tenant_credit_analysis",
            "function": {
                "description": "Analyze a tenant's credit quality with S&P-equivalent ratings, financial health indicators, and lease covenant analysis. Returns watchlist flags for risky tenants.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "tenantName": {
                            "type": "string",
                            "description": "Tenant name, e.g. 'Walgreens', 'Dollar General', 'FedEx'"
                        },
                        "leaseTermYears": {
                            "type": "float",
                            "description": "Remaining lease term in years"
                        },
                        "annualRent": {
                            "type": "float",
                            "description": "Annual rent in dollars"
                        },
                        "propertyType": {
                            "type": "string",
                            "description": "Property type, e.g. 'NNN retail', 'industrial'"
                        },
                        "propertySqft": {
                            "type": "float",
                            "description": "Property square footage for occupancy cost analysis"
                        }
                    },
                    "required": [
                        "tenantName"
                    ]
                }
            },
            "class": "orchestrator_api.OrchestratorTool",
            "args": {
                "tool_name": "tenant_credit_analysis"
            }
        }
    ]
