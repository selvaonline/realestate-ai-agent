# ---- LLM Provider (set at least ONE; first available is used) ----
# Priority: OpenAI → Gemini → Grok → Groq (Llama)

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini – free tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# xAI Grok (https://console.x.ai/)
XAI_API_KEY=

# Groq / Llama – free tier (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: Serper.dev for web search (https://serper.dev)
# If not set, Playwright browser search is used automatically.
SERPER_API_KEY=

# CORS Configuration
# For production, set to your frontend domain(s), comma-separated
# Example: CORS_ORIGINS=https://deal-agent-ui.onrender.com,http://localhost:4200
# If you add the Python parser later:
# PY_BASE=http://localhost:8000

# Comet Browser Agent (always-on monitoring)
COMET_ENABLED=true
COMET_DATA_DIR=.comet
SLACK_WEBHOOK_URL=
# For development, you can use "*" but NOT recommended for production
CORS_ORIGINS=*

# Browser settings
BROWSER_HEADED=false
BROWSER_DEVTOOLS=false
BROWSER_ENGINE=chromium
BROWSER_SLOWMO=0

# Bright Data proxy (optional - for bypassing Cloudflare)
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=
BRIGHTDATA_HOST=brd.superproxy.io:33335
BRIGHTDATA_SESSION=

# Screenshot settings
CAPTURE_ON_BLOCK=true

# PE Scoring & Analytics
# PE_MODE: "private" (default, family office style) or "institutional" (PGIM-style: heavier tenant/market weights, deal size filters)
PE_MODE=private
SKIP_EXTRACTION=true
MIN_BROWSE_SCORE=70

PORT=3001

# Agent Mode: "pipeline" (default, fixed search pipeline) or "agentic" (LLM-driven multi-hop reasoning)
AGENT_MODE=agentic

# --- Market Data APIs (optional; risk intelligence will degrade gracefully if missing) ---
# FRED (Federal Reserve Economic Data) API key for Treasury rates: https://fred.stlouisfed.org/
# Provides 10-Year Treasury (DGS10) for interest rate risk analysis
FRED_API_KEY=

# BLS (Bureau of Labor Statistics) API key for metro unemployment data: https://www.bls.gov/developers/
# Provides local labor market conditions for metro-level risk assessment
BLS_API_KEY=

# Browser Automation Settings (Optional)
# BROWSER_HEADED=false          # Set to true to see browser window
# BROWSER_DEVTOOLS=false        # Set to true to open DevTools (Chromium only)
